# Firebase Web SDK Configuration (used for standalone / Vercel deployments)
# In AI Studio, firebase-applet-config.json is automatically provisioned and used as fallback.
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_DATABASE_ID="(default)"

# Application URL (used for deployment metadata)
APP_URL="http://localhost:3000"
